{
  "name": "dhl-er-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "migrate": "npm run migrate --workspace=apps/api",
    "migrate:down": "npm run migrate:down --workspace=apps/api",
    "seed": "npm run seed --workspace=apps/api",
    "test:api": "npm run test --workspace=apps/api",
    "build:web": "cd apps/web && npx vite build",
    "build": "cd apps/web && npx vite build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.439.0",
    "node-pg-migrate": "^7.5.2",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "vite": "^5.4.0"
  }
}
